---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'

interface Props {
  frontmatter: { title: string; description: string; updated: string; cutout?: string; cutoutAlt?: string }
}
const { title, description, updated, cutout, cutoutAlt = '' } = Astro.props.frontmatter
const pageTitle = `${title} · Smetase`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://smetase.com')} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Martian+Mono:wght@400;500&family=Unbounded:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main class="legal">
      <div class="legal__head">
        <h1 class="legal__title display" data-split>{title}</h1>
        <p class="legal__updated">Last updated {updated}</p>
      </div>

      <div class="legal__body">
        <article class="legal__text">
          <slot />
        </article>
        {
          cutout ? (
            <aside class="legal__art">
              <figure class="legal__cutout tex" data-texture="cutout">
                <img src={`/images/${cutout}.webp`} alt={cutoutAlt} loading="eager" />
              </figure>
            </aside>
          ) : null
        }
      </div>
    </main>
    <Footer />
    <script>
      import '../scripts/main.ts'
    </script>
  </body>
</html>

<style>
  .legal {
    padding: clamp(120px, 20vh, 220px) var(--gutter) clamp(80px, 14vh, 160px);
  }
  .legal__title {
    font-size: clamp(44px, 8.4vw, 150px);
  }
  .legal__updated {
    margin-top: 20px;
    color: var(--muted);
    font-size: 15px;
  }
  .legal__body {
    display: grid;
    grid-template-columns: minmax(0, 44rem) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 120px);
    margin-top: clamp(56px, 10vh, 120px);
  }
  .legal__art {
    position: relative;
  }
  .legal__cutout {
    position: sticky;
    top: 12vh;
    margin: 0;
    height: 76vh;
    background: transparent;
  }
  .legal__cutout img {
    object-fit: contain;
    object-position: bottom center;
    /* Black and white even when the texture is wiped away. */
    filter: grayscale(1) contrast(1.05);
  }

  .legal__text {
    font-size: 17px;
    line-height: 1.7;
    color: #262626;
  }
  .legal__text :global(h2) {
    margin: 3.2rem 0 0.9rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2vw, 30px);
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }
  .legal__text :global(h3) {
    margin: 2rem 0 0.5rem;
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
  }
  .legal__text :global(p),
  .legal__text :global(ul),
  .legal__text :global(ol) {
    margin: 0 0 1rem;
  }
  .legal__text :global(ul),
  .legal__text :global(ol) {
    padding-left: 1.25rem;
  }
  .legal__text :global(li) {
    margin-bottom: 0.4rem;
  }
  .legal__text :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .legal__text :global(a) {
    color: var(--ink);
    text-underline-offset: 4px;
  }
  .legal__text :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1rem;
    font-size: 15px;
  }
  .legal__text :global(th),
  .legal__text :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.7rem 0.75rem 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .legal__text :global(th) {
    font-weight: 600;
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .legal__body {
      grid-template-columns: 1fr;
    }
    .legal__art {
      order: -1;
    }
    .legal__cutout {
      position: relative;
      top: 0;
      height: 52vh;
    }
  }
</style>
