---
// The bite. Black until you reach for the button; then colour floods out from the pointer,
// and a click sweeps the whole screen before opening the app.
import { APP_URL, TELEGRAM_URL } from '../config'
---

<section class="final" aria-labelledby="final-title" data-final>
  <div class="final__flood" aria-hidden="true" data-flood></div>
  <div class="final__inner">
    <h2 id="final-title" class="final__title display" data-split>
      Your next step is <span class="light">one message away.</span>
    </h2>
    <a class="final__cta display" href={APP_URL} data-bite>
      <span class="final__cta-text">Start on the web</span>
      <span class="final__cta-arrow" aria-hidden="true">↗</span>
    </a>
    {
      TELEGRAM_URL ? (
        <a class="cta final__alt" href={TELEGRAM_URL}>
          Or open Smetase in Telegram <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ) : null
    }
  </div>
</section>
<div class="curtain" aria-hidden="true" data-curtain></div>

<style>
  .final {
    --fx: 50%;
    --fy: 50%;
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    padding: clamp(120px, 22vh, 240px) var(--gutter) clamp(80px, 14vh, 160px);
  }
  .final__flood {
    position: absolute;
    inset: 0;
    background: var(--blue);
    clip-path: circle(0px at var(--fx) var(--fy));
  }
  .final__inner {
    position: relative;
  }
  .final__title {
    font-size: clamp(40px, 6.4vw, 116px);
    max-width: 10em;
  }
  .final__title .light {
    display: block;
  }
  .final__cta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3em;
    margin-top: clamp(56px, 10vh, 120px);
    padding: 0.18em 0 0.22em;
    border-top: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    font-size: clamp(30px, 7.4vw, 150px);
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
  }
  .final__cta-arrow {
    display: inline-block;
    font-weight: 300;
    transition: transform 0.8s var(--ease-out);
  }
  .final__cta:hover .final__cta-arrow,
  .final__cta:focus-visible .final__cta-arrow {
    transform: translate(0.12em, -0.12em) rotate(45deg);
  }
  .final__alt {
    margin-top: 32px;
    color: var(--paper);
  }
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--blue);
    transform: translateY(100%);
    pointer-events: none;
    will-change: transform;
  }
</style>

<script>
  import type { gsap as Gsap } from 'gsap'
  window.addEventListener('smetase:ready', (event) => {
    const { gsap, reduceMotion } = (event as CustomEvent<{ gsap: typeof Gsap; reduceMotion: boolean }>).detail
    const section = document.querySelector<HTMLElement>('[data-final]')
    const cta = document.querySelector<HTMLAnchorElement>('[data-bite]')
    const curtain = document.querySelector<HTMLElement>('[data-curtain]')
    const flood = section?.querySelector<HTMLElement>('[data-flood]')
    if (!section || !cta || !curtain || !flood) return

    const state = { r: 0 }
    const paint = () => (flood.style.clipPath = `circle(${state.r}px at var(--fx) var(--fy))`)
    const aim = (event: PointerEvent | FocusEvent) => {
      const box = section.getBoundingClientRect()
      if ('clientX' in event) {
        section.style.setProperty('--fx', `${event.clientX - box.left}px`)
        section.style.setProperty('--fy', `${event.clientY - box.top}px`)
      } else {
        const c = cta.getBoundingClientRect()
        section.style.setProperty('--fx', `${c.left + c.width / 2 - box.left}px`)
        section.style.setProperty('--fy', `${c.top + c.height / 2 - box.top}px`)
      }
    }
    const fill = () => Math.hypot(section.clientWidth, section.clientHeight) * 1.1
    const open = (event: PointerEvent | FocusEvent) => {
      aim(event)
      gsap.to(state, { r: fill(), duration: reduceMotion ? 0 : 1.2, ease: 'expo.out', onUpdate: paint })
    }
    const close = () => gsap.to(state, { r: 0, duration: reduceMotion ? 0 : 0.8, ease: 'expo.inOut', onUpdate: paint })

    cta.addEventListener('pointerenter', open)
    cta.addEventListener('focus', open)
    cta.addEventListener('pointerleave', close)
    cta.addEventListener('blur', close)

    // A plain click still works if anything below fails; we only add the sweep on top.
    cta.addEventListener('click', (event) => {
      if (reduceMotion || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return
      event.preventDefault()
      gsap.to(curtain, {
        yPercent: 0,
        duration: 0.7,
        ease: 'expo.inOut',
        onComplete: () => {
          window.location.href = cta.href
        },
      })
    })
    // Coming back with the browser's back button: lift the curtain again.
    gsap.set(curtain, { yPercent: 100 })
    window.addEventListener('pageshow', () => gsap.set(curtain, { yPercent: 100 }))
  })
</script>
