---
// How it works in three steps, then the offer. Each step is a colour card that rises and stacks on
// the one before (sticky), and the card underneath sinks back as the next one covers it.
import { APP_URL } from '../config'

const steps = [
  {
    title: "Say where you're starting from.",
    body: 'Your degree, your grades and what you can spend. Type it like a message, on the web or Telegram.',
    flavour: 'orange',
    texture: 'dots',
    img: { src: '/images/step-phone.webp', alt: 'A young man in glasses smiling as he types on his phone at a desk', w: 1400, h: 1750, pos: '50% 67%' },
  },
  {
    title: 'See courses that fit your budget.',
    body: "Real UK programmes, ranked for you, with tuition checked on the university's own page.",
    flavour: 'yellow',
    texture: 'lines',
    img: { src: '/images/step-laptop.webp', alt: 'A student working on a laptop in a classroom', w: 1400, h: 933 },
  },
  {
    title: 'Follow your plan to the visa.',
    body: 'Deposit, English test, proof of funds, visa, in order. Send the link to your parents.',
    flavour: 'green',
    texture: 'dots',
    img: { src: '/images/step-airport.webp', alt: 'A young woman smiling on a call in an airport departure lounge', w: 1400, h: 2100, pos: '60% 45%' },
  },
]
---

<section class="steps" id="how" aria-labelledby="steps-title">
  <h2 id="steps-title" class="steps__title display" data-split>
    Three steps <span class="light">to your plan.</span>
  </h2>

  <ol class="steps__stack" data-steps>
    {
      steps.map((step, i) => (
        <li class={`card card--${step.flavour}`} style={`--i: ${i}`} data-card>
          <div class="card__copy">
            <span class="card__num display" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3 class="card__title display">{step.title}</h3>
              <p class="card__body">{step.body}</p>
            </div>
          </div>
          <figure class="card__photo tex" data-texture={step.texture}>
            <img
              src={step.img.src}
              alt={step.img.alt}
              width={step.img.w}
              height={step.img.h}
              style={step.img.pos ? `object-position: ${step.img.pos}` : undefined}
              loading="lazy"
            />
          </figure>
          <div class="card__shade" aria-hidden="true" data-shade />
        </li>
      ))
    }
  </ol>

  <div class="steps__offer" data-rise>
    <p class="steps__free">
      Free for students. <span class="dim">No agent fees to use Smetase.</span>
    </p>
    <a class="cta cta--block" href={APP_URL}>Find my programmes <span class="arrow" aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .steps {
    --top: clamp(76px, 11vh, 110px);
    --peek: 26px;
    padding: clamp(96px, 16vh, 180px) var(--gutter);
  }
  .steps__title {
    font-size: clamp(40px, 6.4vw, 116px);
    max-width: 9em;
  }

  .steps__stack {
    list-style: none;
    margin: clamp(48px, 9vh, 96px) 0 0;
    padding: 0;
  }
  .card {
    position: sticky;
    top: calc(var(--top) + var(--i) * var(--peek));
    height: min(calc(100svh - var(--top) - 3 * var(--peek) - 24px), 760px);
    margin-bottom: clamp(48px, 12vh, 140px);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(20px, 3vw, 48px);
    padding: clamp(20px, 2.6vw, 40px);
    background: var(--c);
    color: var(--ink);
    transform-origin: 50% 0;
    overflow: hidden;
  }
  .card:last-child {
    margin-bottom: 0;
  }
  /* Like a traffic light: stop, get ready, go. */
  .card--orange {
    --c: var(--orange);
  }
  .card--yellow {
    --c: var(--yellow);
  }
  .card--green {
    --c: var(--green);
  }

  .card__copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }
  .card__num {
    font-weight: 300;
    font-size: clamp(110px, 17vw, 300px);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }
  .card__title {
    font-size: clamp(28px, 3.6vw, 64px);
    line-height: 0.98;
    max-width: 10em;
    text-wrap: balance;
  }
  .card__body {
    margin-top: clamp(14px, 2vh, 24px);
    max-width: 32ch;
    font-size: clamp(16px, 1.25vw, 19px);
    opacity: 0.8;
  }
  .card__photo {
    margin: 0;
    min-height: 0;
  }
  .card__shade {
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
  }

  .steps__offer {
    margin-top: clamp(56px, 10vh, 112px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    flex-wrap: wrap;
  }
  .steps__free {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .steps__free .dim {
    color: #a3a3a3;
  }

  @media (max-width: 760px) {
    .steps {
      --peek: 18px;
    }
    .card {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
    }
    .card__photo {
      order: -1;
    }
    .card__copy {
      flex-direction: row;
      align-items: flex-end;
      gap: 16px;
    }
    .card__num {
      font-size: clamp(72px, 24vw, 120px);
    }
    .card__title {
      font-size: clamp(24px, 7vw, 34px);
    }
    .card__body {
      font-size: 15px;
    }
  }
</style>

<script>
  import type { gsap as Gsap } from 'gsap'

  // As each card covers the one before, that one sinks back: a little smaller and darker.
  window.addEventListener('smetase:ready', (event) => {
    const { gsap, reduceMotion } = (event as CustomEvent<{ gsap: typeof Gsap; reduceMotion: boolean }>).detail
    if (reduceMotion) return
    const cards = gsap.utils.toArray<HTMLElement>('[data-card]')
    cards.slice(0, -1).forEach((card, i) => {
      const next = cards[i + 1]
      // Ends when the next card reaches its sticky spot.
      const st = { trigger: next, start: 'top bottom', end: () => `top ${parseFloat(getComputedStyle(next).top)}px`, scrub: true }
      gsap.to(card, { scale: 0.94, ease: 'none', scrollTrigger: st })
      gsap.to(card.querySelector('[data-shade]'), { opacity: 0.35, ease: 'none', scrollTrigger: st })
    })
  })
</script>
