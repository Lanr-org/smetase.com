---
import { SOCIALS } from '../config'

interface Props {
  size?: string
}
const { size = '22px' } = Astro.props
---

<ul class="socials" style={`--icon:${size}`}>
  {
    SOCIALS.map((s) => (
      <li>
        {s.url ? (
          <a class="socials__icon" href={s.url} aria-label={`Smetase on ${s.name}`} style={`--src:url(/social/${s.icon}.svg)`} />
        ) : (
          <span class="socials__icon" role="img" aria-label={s.name} style={`--src:url(/social/${s.icon}.svg)`} />
        )}
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .socials__icon {
    display: grid;
    place-items: center;
    width: calc(var(--icon) * 2.1);
    height: calc(var(--icon) * 2.1);
    border: 1px solid currentColor;
    border-radius: 50%;
    color: inherit;
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out);
  }
  .socials__icon::before {
    content: '';
    width: var(--icon);
    height: var(--icon);
    background: currentColor;
    -webkit-mask: var(--src) center / contain no-repeat;
    mask: var(--src) center / contain no-repeat;
  }
  a.socials__icon:hover {
    background: var(--paper);
    color: var(--ink);
  }
</style>
