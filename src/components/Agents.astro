---
import { PARTNERS_EMAIL } from '../config'
---

<section class="agents" id="agents" aria-labelledby="agents-title">
  <figure class="agents__photo tex" data-texture="lines" data-parallax="8">
    <img
      src="/images/umbrella.webp"
      alt="A smiling man in a grey shirt standing outdoors with his arms folded"
      width="1000"
      height="1500"
      loading="lazy"
    />
  </figure>
  <div class="agents__copy">
    <h2 id="agents-title" class="agents__title display" data-split>
      Agents, <span class="light">bring what you know.</span>
    </h2>
    <p class="statement agents__statement" data-split>
      We bring you students who already know what they want, with their plan in front of you.{' '}
      <span class="dim">You advise. Everything stays in one chat.</span>
    </p>
    <a class="cta" href={`mailto:${PARTNERS_EMAIL}?subject=Partnering%20with%20Smetase`} data-rise>
      Partner with Smetase <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .agents {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(32px, 6vw, 120px);
    align-items: end;
    padding: clamp(110px, 18vh, 200px) var(--gutter);
    background: var(--paper);
  }
  .agents__photo {
    margin: 0;
    aspect-ratio: 2 / 3;
  }
  .agents__title {
    font-size: clamp(40px, 6.4vw, 116px);
  }
  .agents__title .light {
    display: block;
  }
  .agents__statement {
    margin: clamp(32px, 6vh, 64px) 0 40px;
    font-size: clamp(22px, 2.4vw, 38px);
    max-width: 22em;
  }
  @media (max-width: 860px) {
    .agents {
      grid-template-columns: 1fr;
    }
    .agents__photo {
      width: 70%;
    }
  }
</style>
