---
import '../styles/global.css'
import Hero from '../components/Hero.astro'
import Nav from '../components/Nav.astro'
import Agents from '../components/Agents.astro'
import Board from '../components/Board.astro'
import Final from '../components/Final.astro'
import Footer from '../components/Footer.astro'
import Journey from '../components/Journey.astro'
import Noise from '../components/Noise.astro'
import Parents from '../components/Parents.astro'
import ProductStory from '../components/ProductStory.astro'

const title = 'Smetase — study abroad without the guesswork'
const description =
  'Smetase is a study-abroad advisor you can text. Real programmes, fees checked against the course page, and a person when it matters.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://smetase.com" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href="https://smetase.com/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Smetase',
        url: 'https://smetase.com',
        logo: 'https://smetase.com/favicon.svg',
        email: 'hello@smetase.com',
        description,
      })}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Martian+Mono:wght@400;500&family=Unbounded:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <Hero />
      <Noise />
      <ProductStory />
      <Journey />
      <Board />
      <Parents />
      <Agents />
      <Final />
    </main>
    <Footer />
    <div class="smell" aria-hidden="true"></div>
    <script>
      import '../scripts/main.ts'
    </script>
  </body>
</html>
